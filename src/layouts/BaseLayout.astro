---
import '@fontsource-variable/source-serif-4';
import Analytics from '@vercel/analytics/astro';
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import JsonLd from '@/components/JsonLd.astro';
import { SITE_LANG } from '@/consts';
import { personJsonLd, websiteJsonLd, type SeoInput } from '@/lib/seo';

type Props = SeoInput & {
  jsonLd?: Array<Record<string, unknown> | null | undefined | false>;
  /** Skip the default WebSite/Person JSON-LD on this page. */
  skipDefaultJsonLd?: boolean;
};

const { jsonLd = [], skipDefaultJsonLd = false, ...seo } = Astro.props;
const defaults = skipDefaultJsonLd ? [] : [websiteJsonLd(), personJsonLd()];
const allJsonLd = [...defaults, ...jsonLd];

// Dev only: Tailwind drops CSS comments, so the Hallmark audit (run against the
// dev server, or a local build with HALLMARK_AUDIT=1) reads each page's hero
// posture from here. Never in a normal build.
const HALLMARK_STAMP = '/* Hallmark · hero: banner, counter (/) · posture: restrained · shape: Ecosystem Index · genre: editorial */';
---
<!doctype html>
<html lang={SITE_LANG} class="overflow-x-clip">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <BaseHead {...seo} />
    <JsonLd data={allJsonLd} />
    {(import.meta.env.DEV || process.env.HALLMARK_AUDIT) && <style is:inline set:html={HALLMARK_STAMP} />}
  </head>
  <body class="overflow-x-clip">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
