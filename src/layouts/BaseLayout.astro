---
import '@fontsource-variable/source-serif-4';
import Analytics from '@vercel/analytics/astro';
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import JsonLd from '@/components/JsonLd.astro';
import { SITE_LANG } from '@/consts';
import { personJsonLd, websiteJsonLd, type SeoInput } from '@/lib/seo';

type Props = SeoInput & {
  jsonLd?: Array<Record<string, unknown> | null | undefined | false>;
  /** Skip the default WebSite/Person JSON-LD on this page. */
  skipDefaultJsonLd?: boolean;
};

const { jsonLd = [], skipDefaultJsonLd = false, ...seo } = Astro.props;
const defaults = skipDefaultJsonLd ? [] : [websiteJsonLd(), personJsonLd()];
const allJsonLd = [...defaults, ...jsonLd];
---
<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <BaseHead {...seo} />
    <JsonLd data={allJsonLd} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
