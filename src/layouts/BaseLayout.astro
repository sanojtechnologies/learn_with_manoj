---
import Analytics from '@vercel/analytics/astro';
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import JsonLd from '@/components/JsonLd.astro';
import { SITE_LANG } from '@/consts';
import { personJsonLd, websiteJsonLd, type SeoInput } from '@/lib/seo';

type Props = SeoInput & {
  jsonLd?: Array<Record<string, unknown> | null | undefined | false>;
  /** Skip the default WebSite/Person JSON-LD on this page. */
  skipDefaultJsonLd?: boolean;
};

const { jsonLd = [], skipDefaultJsonLd = false, ...seo } = Astro.props;
const defaults = skipDefaultJsonLd ? [] : [websiteJsonLd(), personJsonLd()];
const allJsonLd = [...defaults, ...jsonLd];
---
<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <BaseHead {...seo} />
    <JsonLd data={allJsonLd} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:rounded focus:bg-white focus:px-3 focus:py-1.5 focus:text-slate-900 focus:shadow">
      Skip to content
    </a>
    <Header />
    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6 sm:py-12">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
