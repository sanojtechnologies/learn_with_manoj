---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SubscribeCTA from '@/components/SubscribeCTA.astro';
import ShareLinks from '@/components/ShareLinks.astro';
import YouTubeEmbed from '@/components/YouTubeEmbed.astro';
import PostRow from '@/components/PostRow.astro';
import {
  blogPostingJsonLd,
  breadcrumbJsonLd,
  videoObjectJsonLd,
  absoluteUrl,
} from '@/lib/seo';
import { formatDate, getPublishedPosts, postUrl, readingTime, tagUrl, type Post } from '@/lib/posts';
import { SERIES, seriesEpisodes } from '@/lib/series';
import { fetchLatestVideos } from '@/lib/youtube';
import { YT_CHANNEL_ID } from '@/consts';

interface Props {
  post: Post;
  related: Post[];
  body?: string;
}

const { post, related, body } = Astro.props;
const { data, id } = post;
const path = `/blog/${id}`;
const url = absoluteUrl(path);
const heroPath = data.heroImage?.src ?? '/og-default.png';
const heroAlt = data.heroAlt ?? data.title;
const minutes = readingTime(body);

// The post's series, as a syllabus beside the article with this episode marked.
const seriesDef = SERIES.find((s) => data.tags.some((t) => s.tags.includes(t)));
const episodes = seriesDef
  ? seriesEpisodes(
      seriesDef,
      await getPublishedPosts(),
      new Map((await fetchLatestVideos(YT_CHANNEL_ID)).map((v) => [v.id, v.title])),
    )
  : [];

const jsonLd = [
  blogPostingJsonLd({
    title: data.title,
    description: data.description,
    url,
    image: absoluteUrl(heroPath),
    publishedAt: data.pubDate.toISOString(),
    updatedAt: data.updatedDate?.toISOString(),
    tags: data.tags,
  }),
  breadcrumbJsonLd([
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
    { name: data.title, url: path },
  ]),
  data.youtubeId
    ? videoObjectJsonLd({
        videoId: data.youtubeId,
        name: data.title,
        description: data.description,
        uploadDate: data.pubDate.toISOString(),
      })
    : null,
];
---
<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.description}
  path={path}
  image={heroPath}
  imageAlt={heroAlt}
  ogType="article"
  publishedAt={data.pubDate}
  updatedAt={data.updatedDate}
  tags={data.tags}
  jsonLd={jsonLd}
>
  <article>
    <div class="container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol>
          <li><a href="/">LearnwithManoj</a></li>
          <li><a href="/blog">All posts</a></li>
          <li aria-current="page">{data.title}</li>
        </ol>
      </nav>

      <header class="article-head">
        <div>
          <h1>{data.title}</h1>
          <p class="lead">{data.description}</p>
        </div>
        <div class="article-meta">
          <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
          {data.updatedDate && (
            <span>Updated <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time></span>
          )}
          <span>{minutes} min read</span>
          {data.tags.length > 0 && (
            <ul>
              {data.tags.map((tag) => (
                <li><a href={tagUrl(tag)} class="tag">#{tag}</a></li>
              ))}
            </ul>
          )}
        </div>
      </header>

      <div class="article-body">
        <div>
          {data.youtubeId && (
            <>
              <YouTubeEmbed id={data.youtubeId} title={data.title} />
              <SubscribeCTA variant="inline" />
            </>
          )}

          <div class="prose max-w-none">
            <slot />
          </div>

          <ShareLinks url={url} title={data.title} />
        </div>

        {seriesDef && episodes.length > 1 && (
          <aside class="series-aside" aria-labelledby="series-aside-heading">
            <h2 id="series-aside-heading">{seriesDef.label}</h2>
            <ol class="syllabus syllabus--compact">
              {episodes.map((e) => (
                <li class:list={{ 'is-current': e.post.id === id }}>
                  <span class="num">{e.number ?? ''}</span>
                  {e.post.id === id
                    ? <span aria-current="page">{e.post.data.title}</span>
                    : <a href={postUrl(e.post)}>{e.post.data.title}</a>}
                </li>
              ))}
            </ol>
          </aside>
        )}
      </div>
    </div>
  </article>

  <SubscribeCTA />

  {related.length > 0 && (
    <section class="section" aria-labelledby="related-heading">
      <div class="container">
        <div class="section-head">
          <h2 id="related-heading">Related posts</h2>
        </div>
        <ol class="rows">
          {related.map((rel) => <PostRow post={rel} />)}
        </ol>
      </div>
    </section>
  )}
</BaseLayout>
