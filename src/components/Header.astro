---
import { NAV_LINKS, SITE_TAGLINE, SITE_TITLE, YT_SUBSCRIBE_URL } from '@/consts';
import { getPublishedPosts, postUrl } from '@/lib/posts';

const pathname = Astro.url.pathname.replace(/\/$/u, '') || '/';
const isActive = (href: string): boolean => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
};

// The banner names the newest post that has a video: the latest episode.
const latest = (await getPublishedPosts()).find((p) => p.data.youtubeId);
// On the homepage the hero already leads with this episode.
const showBanner = latest && pathname !== '/' && pathname !== postUrl(latest);
---
{showBanner && latest && (
  <div class="site-banner">
    <div class="container">
      <span>New episode:</span>
      <a href={postUrl(latest)}>{latest.data.title}</a>
    </div>
  </div>
)}
<header class="site-bar">
  <div class="container">
    <a href="/" class="wordmark" aria-label={`${SITE_TITLE}: ${SITE_TAGLINE}`}>
      <span class="wordmark-tile" aria-hidden="true">M</span>
      <span>
        <span class="wordmark-name">{SITE_TITLE}</span>
        <span class="wordmark-tag">{SITE_TAGLINE}</span>
      </span>
    </a>

    <nav aria-label="Primary" class="site-nav">
      {NAV_LINKS.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <a href={YT_SUBSCRIBE_URL} target="_blank" rel="noopener" class="btn btn--signal">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/>
      </svg>
      <span>Subscribe</span>
    </a>
  </div>
</header>
