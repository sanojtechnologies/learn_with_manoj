---
import { NAV_LINKS, SITE_TAGLINE, SITE_TITLE, YT_SUBSCRIBE_URL } from '@/consts';

const pathname = Astro.url.pathname.replace(/\/$/u, '') || '/';
const isActive = (href: string): boolean => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
};
---
<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur dark:border-slate-800/70 dark:bg-slate-950/80">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 tracking-tight" aria-label={`${SITE_TITLE} — ${SITE_TAGLINE}`}>
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-brand-600 text-sm font-bold text-white">M</span>
      <span class="flex flex-col leading-tight">
        <span class="font-semibold">{SITE_TITLE}</span>
        <span class="hidden text-[11px] font-medium tracking-wide text-slate-500 sm:inline dark:text-slate-400">
          {SITE_TAGLINE}
        </span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 text-sm sm:flex">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'rounded-md px-3 py-1.5 transition-colors',
            isActive(link.href)
              ? 'bg-slate-100 font-medium text-slate-900 dark:bg-slate-800 dark:text-white'
              : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href={YT_SUBSCRIBE_URL}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-1.5 rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-red-700"
    >
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/>
      </svg>
      <span class="hidden sm:inline">Subscribe</span>
    </a>
  </div>

  <nav aria-label="Primary mobile" class="border-t border-slate-200/70 px-4 py-2 sm:hidden dark:border-slate-800/70">
    <ul class="flex gap-1 overflow-x-auto text-sm">
      {NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'inline-block rounded-md px-3 py-1.5 whitespace-nowrap',
              isActive(link.href)
                ? 'bg-slate-100 font-medium text-slate-900 dark:bg-slate-800 dark:text-white'
                : 'text-slate-600 dark:text-slate-300',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
