---
import { AUTHOR_NAME, SANOJ_TECHNOLOGIES_URL, SITE_TAGLINE, SITE_TITLE, YT_CHANNEL_URL } from '@/consts';
const year = new Date().getFullYear();
---
<footer class="site-foot">
  <div class="container">
    <p class="site-foot-sign">
      {SITE_TAGLINE}
      <small>{AUTHOR_NAME}, {SITE_TITLE}</small>
    </p>
    <nav aria-label="Footer">
      <a href="/rss.xml">RSS</a>
      <a href="/sitemap-index.xml">Sitemap</a>
      <a href={YT_CHANNEL_URL} target="_blank" rel="noopener">YouTube</a>
      <a href={SANOJ_TECHNOLOGIES_URL} target="_blank" rel="noopener">Coaching</a>
    </nav>
    <p class="site-foot-legal">&copy; {year} {SITE_TITLE}. All rights reserved. Built with Astro.</p>
  </div>
</footer>
