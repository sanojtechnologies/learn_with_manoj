---
import type { YouTubeVideo } from '@/lib/youtube';
import { formatDate } from '@/lib/posts';

interface Props {
  video: YouTubeVideo;
  headingLevel?: 2 | 3;
  /** Load the thumbnail at once: for cards on the first screen. */
  eager?: boolean;
}

const { video, headingLevel = 3, eager = false } = Astro.props;
const HeadingTag = `h${headingLevel}` as 'h2' | 'h3';
---
<article class="video">
  <a href={video.url} target="_blank" rel="noopener" class="video-frame" tabindex="-1" aria-hidden="true">
    <img
      src={video.thumbnail}
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      width="480"
      height="360"
    />
  </a>
  <HeadingTag class="video-title">
    <a href={video.url} target="_blank" rel="noopener">{video.title}</a>
  </HeadingTag>
  {video.publishedAt && (
    <time datetime={video.publishedAt.toISOString()} class="meta">
      {formatDate(video.publishedAt)}
    </time>
  )}
</article>
