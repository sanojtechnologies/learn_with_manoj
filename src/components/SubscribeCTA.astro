---
import { SITE_TITLE, YT_HANDLE, YT_SUBSCRIBE_URL } from '@/consts';

interface Props {
  variant?: 'default' | 'inline';
  heading?: string;
  body?: string;
  ctaLabel?: string;
}

// Per-variant defaults. The inline CTA (rendered immediately under the video
// embed) uses different anchor text from the bottom-of-post CTA so the same
// page doesn't ship two identical anchors when both render.
const {
  variant = 'default',
  heading = `Subscribe to ${SITE_TITLE} on YouTube`,
  body = variant === 'inline'
    ? `Like this format? Hundreds more walkthroughs like this one live on the channel — new videos drop weekly.`
    : `Practical engineering walkthroughs, system design deep-dives, and code-first tutorials — new videos drop weekly. Subscribe so you never miss one.`,
  ctaLabel = variant === 'inline' ? 'Watch the channel' : 'Subscribe on YouTube',
} = Astro.props;
---
<aside
  class:list={[
    'not-prose my-8 flex flex-col items-start gap-3 rounded-xl border p-5 sm:flex-row sm:items-center sm:justify-between',
    variant === 'inline'
      ? 'border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/60'
      : 'border-red-200 bg-red-50/70 dark:border-red-900/40 dark:bg-red-950/30',
  ]}
>
  <div class="min-w-0">
    <p class="text-base font-semibold text-slate-900 dark:text-white">{heading}</p>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{body}</p>
  </div>
  <a
    href={YT_SUBSCRIBE_URL}
    target="_blank"
    rel="noopener"
    class="inline-flex shrink-0 items-center gap-2 rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition-colors hover:bg-red-700"
    aria-label={`Subscribe to ${YT_HANDLE} on YouTube`}
  >
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
      <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/>
    </svg>
    {ctaLabel}
  </a>
</aside>
