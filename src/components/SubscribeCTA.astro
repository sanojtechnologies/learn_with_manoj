---
import { SITE_TITLE, YT_HANDLE, YT_SUBSCRIBE_URL } from '@/consts';

interface Props {
  variant?: 'default' | 'inline';
  heading?: string;
  body?: string;
  ctaLabel?: string;
}

// Per-variant defaults. The inline CTA (rendered immediately under the video
// embed) uses different anchor text from the bottom-of-post CTA so the same
// page doesn't ship two identical anchors when both render.
const {
  variant = 'default',
  heading = `Subscribe to ${SITE_TITLE} on YouTube`,
  body = variant === 'inline'
    ? `Like this format? More walkthroughs like this one live on the channel, with new videos every week.`
    : `Practical engineering walkthroughs, system design deep-dives, and code-first tutorials, with new videos every week. Subscribe so you never miss one.`,
  ctaLabel = variant === 'inline' ? 'Watch the channel' : 'Subscribe on YouTube',
} = Astro.props;
---
{variant === 'inline' ? (
  <aside class="inline-cta not-prose">
    <p><strong>{heading}</strong>{body}</p>
    <a href={YT_SUBSCRIBE_URL} target="_blank" rel="noopener" class="btn btn--signal" aria-label={`Subscribe to ${YT_HANDLE} on YouTube`}>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/></svg>
      {ctaLabel}
    </a>
  </aside>
) : (
  <section class="close not-prose" aria-labelledby="subscribe-heading">
    <div class="container">
      <div>
        <h2 id="subscribe-heading">{heading}</h2>
        <p>{body}</p>
      </div>
      <a href={YT_SUBSCRIBE_URL} target="_blank" rel="noopener" class="btn btn--signal" aria-label={`Subscribe to ${YT_HANDLE} on YouTube`}>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/></svg>
        {ctaLabel}
      </a>
    </div>
  </section>
)}
