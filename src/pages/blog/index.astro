---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostRow from '@/components/PostRow.astro';
import { SITE_TITLE } from '@/consts';
import { getPublishedPosts, summarizeTags } from '@/lib/posts';
import { breadcrumbJsonLd } from '@/lib/seo';

const posts = await getPublishedPosts();
const tags = summarizeTags(posts).slice(0, 12);
const title = 'Engineering blog';
const description = `All written deep-dives from ${SITE_TITLE}: system design, code-first tutorials, and engineering walkthroughs.`;
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
  ]),
];
---
<BaseLayout title={title} description={description} path="/blog" jsonLd={jsonLd}>
  <div class="container">
    <header class="page-head">
      <h1>Engineering blog</h1>
      <p class="lead">Written deep-dives and companion notes to the LearnwithManoj YouTube channel.</p>
    </header>

    {tags.length > 0 && (
      <nav aria-label="Topics" class="index-filter">
        {tags.map((t) => (
          <a href={`/tags/${t.slug}`}>#{t.tag}<span class="count">{t.count}</span></a>
        ))}
      </nav>
    )}

    {posts.length === 0 ? (
      <p>No posts yet. Check back soon.</p>
    ) : (
      <ol class="rows">
        {posts.map((post) => <PostRow post={post} headingLevel={2} showTags />)}
      </ol>
    )}
  </div>
</BaseLayout>
