---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VideoCard from '@/components/VideoCard.astro';
import PostRow from '@/components/PostRow.astro';
import SubscribeCTA from '@/components/SubscribeCTA.astro';
import {
  SITE_DESCRIPTION,
  SITE_TITLE,
  YT_CHANNEL_ID,
  YT_HANDLE,
} from '@/consts';
import { formatDate, getPublishedPosts, postUrl } from '@/lib/posts';
import { SERIES, seriesEpisodes } from '@/lib/series';
import { fetchLatestVideos } from '@/lib/youtube';

const [posts, videos] = await Promise.all([
  getPublishedPosts(),
  fetchLatestVideos(YT_CHANNEL_ID),
]);
const videoTitles = new Map(videos.map((v) => [v.id, v.title]));

// The hero leads with the latest episode: the newest post that has a video.
const latest = posts.find((p) => p.data.youtubeId);
const latestSeries = latest
  ? SERIES.find((s) => latest.data.tags.some((t) => s.tags.includes(t)))
  : undefined;
const latestEpisode = latest && latestSeries
  ? seriesEpisodes(latestSeries, posts, videoTitles).find((e) => e.post.id === latest.id)
  : undefined;

// Each series as a numbered syllabus. The per-series copy is the homepage's own.
const seriesCopy: Record<string, { intro: string[]; links: Array<{ href: string; label: string }> }> = {
  'system-design': {
    intro: [
      'Scalability, load balancing, caching, sharding, CAP theorem, monolith versus microservices: the architectural decisions that decide whether your app survives its first growth spurt. Sixteen episodes and counting, taught from interview-ready first principles.',
    ],
    links: [{ href: '/tags/system-design', label: 'All System Design posts' }],
  },
  'design-patterns': {
    intro: [
      "The Gang-of-Four patterns reframed without the ceremony. When Singleton is essential and when it's an anti-pattern. When Adapter saves you and when it's just a name for ordinary code. Real problems, real trade-offs, no UML for its own sake.",
      'Object-oriented design fundamentals: composition over inheritance, programming to interfaces, and the code smells that tell you a class is doing too much. The thinking underneath every design pattern, applied to code you can change in your next pull request.',
    ],
    links: [
      { href: '/tags/design-patterns', label: 'All Design Patterns posts' },
      { href: '/tags/software-engineering', label: 'Software engineering essentials' },
    ],
  },
  ai: {
    intro: [
      'How large language models actually work (tokenization, embeddings, retrieval-augmented generation, fine-tuning, agents, multi-agent systems), explained for people who write production code, not people who read papers. Thirty-plus episodes between the AI Masterclass and AI Explained series.',
    ],
    links: [
      { href: '/tags/ai', label: 'AI for engineers' },
      { href: '/tags/ai-masterclass', label: 'AI Masterclass' },
      { href: '/tags/ai-explained', label: 'AI Explained' },
    ],
  },
};
// The four topic areas, each with its door in: the homepage's own copy.
const startPost = (slug: string) => posts.find((p) => p.id === slug);
const topics = [
  { href: '/tags/system-design', label: 'System Design', text: seriesCopy['system-design'].intro[0], start: startPost('what-is-system-design-beginners-roadmap') },
  { href: '/tags/design-patterns', label: 'Design Patterns', text: seriesCopy['design-patterns'].intro[0], start: startPost('composite-pattern-files-folders-trees') },
  { href: '/tags/ai', label: 'AI for engineers', text: seriesCopy.ai.intro[0], start: startPost('ai-explained-finally-understand-how-ai-works-no-code') },
  { href: '/tags/software-engineering', label: 'Software engineering essentials', text: seriesCopy['design-patterns'].intro[1], start: undefined },
];
const series = SERIES.map((def) => ({
  def,
  episodes: seriesEpisodes(def, posts, videoTitles),
  copy: seriesCopy[def.slug],
}));

const latestPosts = posts.filter((p) => p.id !== latest?.id).slice(0, 5);
const shownVideoIds = new Set(
  [latest, ...latestPosts].map((p) => p?.data.youtubeId).filter(Boolean) as string[],
);
const latestVideos = videos.filter((v) => !shownVideoIds.has(v.id)).slice(0, 8);

// Front-loaded with the three primary keywords readers actually search for
// (system design, design patterns, AI). "for engineers" qualifies audience
// and depth; without it the keywords are too broad and pull in unqualified
// traffic. `resolveSeo()` appends ` | ${SITE_TITLE}`; final rendered title
// is 515 px / 580 px Google SERP budget.
const homepageTitle =
  'System design, design patterns & AI for engineers';

const thumb = (id: string) => `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
const thumbFallback = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---
<BaseLayout title={homepageTitle} description={SITE_DESCRIPTION} path="/">
  <section class="hero">
    <div class="container">
      <div>
        <h1>Practical software engineering, written and on video.</h1>
        <p class="lead">{SITE_DESCRIPTION}</p>
        <div class="hero-actions">
          <a href="/blog" class="btn">Read the blog</a>
          <a href="/videos" class="btn btn--quiet">Watch the videos</a>
        </div>
      </div>

      {latest && latest.data.youtubeId && (
        <article class="episode" aria-labelledby="latest-episode">
          <a href={postUrl(latest)} class="episode-frame" tabindex="-1" aria-hidden="true">
            <img
              src={thumb(latest.data.youtubeId)}
              onerror={`this.onerror=null;this.src='${thumbFallback(latest.data.youtubeId)}'`}
              alt=""
              width="1280"
              height="720"
              fetchpriority="high"
            />
          </a>
          <p class="meta episode-meta">
            <span>Latest episode</span>
            {latestSeries && <span>{latestSeries.label}{latestEpisode?.number !== undefined ? ` ${latestEpisode.number}` : ''}</span>}
            <time datetime={latest.data.pubDate.toISOString()}>{formatDate(latest.data.pubDate)}</time>
          </p>
          <h2 id="latest-episode" class="episode-title">
            <a href={postUrl(latest)}>{latest.data.title}</a>
          </h2>
          <div class="episode-actions">
            <a href={postUrl(latest)} class="btn btn--quiet">Read the post</a>
            <a href={`https://www.youtube.com/watch?v=${latest.data.youtubeId}`} target="_blank" rel="noopener" class="btn btn--quiet">
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="play-mark"><path d="M8 5v14l11-7z" /></svg>
              Watch on YouTube
            </a>
          </div>
        </article>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="topics-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="topics-heading">What you&rsquo;ll find here</h2>
        <p>
          {SITE_TITLE} is the written companion to the {YT_HANDLE} YouTube channel.
          Every video has a post here with chapter timestamps, external references, and the trade-offs that didn&rsquo;t fit on screen, so you can skim, search, and link directly to the bits you need.
          The blog is plain HTML, free of ad trackers, cookies, and pop-ups, fast on mobile, and friendly to whichever feed reader you already use.
          Four topics make up the bulk of the catalogue:
        </p>
      </div>

      <ul class="topics">
        {topics.map((t) => (
          <li>
            <h3><a href={t.href}>{t.label}</a></h3>
            <p>{t.text}</p>
            {t.start && (
              <p class="topic-start"><span>Start here</span> <a href={postUrl(t.start)} class="link">{t.start.data.title}</a></p>
            )}
          </li>
        ))}
      </ul>

      <p class="series-note">
        New to the site? These three posts are the doors into the three biggest topic areas.
        Read one and follow the related-posts trail at the bottom. Each post links to its
        prerequisites and natural follow-ups, so you can build a path through the catalogue
        without knowing the curriculum in advance.
      </p>

      <div class="series" data-tabs>
        <div class="series-tabs" role="tablist" aria-label="Series">
          {series.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${s.def.slug}`}
              aria-controls={`panel-${s.def.slug}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {s.def.label}
            </button>
          ))}
        </div>

        {series.map((s, i) => {
          const numbered = s.episodes.filter((e) => e.number !== undefined);
          const extra = s.episodes.filter((e) => e.number === undefined);
          return (
            <div
              class:list={['series-panel', { 'is-active': i === 0 }]}
              id={`panel-${s.def.slug}`}
              role="tabpanel"
              aria-labelledby={`tab-${s.def.slug}`}
            >
              <div class="series-intro">
                <div>
                  <h3>{s.def.label}</h3>
                  <p class="meta">{s.episodes.length} posts, in episode order</p>
                  <p class="series-links">
                    {s.copy.links.map((l) => <a href={l.href} class="link">{l.label}</a>)}
                  </p>
                </div>
                <div>
                  <ol class="syllabus">
                    {numbered.map((e) => (
                      <li class:list={{ 'is-start': e.isStart }}>
                        <span class="num">{e.number}</span>
                        <a href={postUrl(e.post)}>{e.post.data.title}</a>
                        {e.isStart && <span class="start">Start here</span>}
                      </li>
                    ))}
                  </ol>
                  {extra.length > 0 && (
                    <>
                      <p class="meta syllabus-extra">Also in this series</p>
                      <ul class="syllabus">
                        {extra.map((e) => (
                          <li class:list={{ 'is-start': e.isStart }}>
                            <span class="num"></span>
                            <a href={postUrl(e.post)}>{e.post.data.title}</a>
                            {e.isStart && <span class="start">Start here</span>}
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {latestPosts.length > 0 && (
    <section class="section" aria-labelledby="latest-posts-heading">
      <div class="container">
        <div class="section-head">
          <h2 id="latest-posts-heading">Latest posts</h2>
          <a href="/blog" class="link">All posts</a>
        </div>
        <ol class="rows">
          {latestPosts.map((post) => <PostRow post={post} />)}
        </ol>
      </div>
    </section>
  )}

  {latestVideos.length > 0 && (
    <section class="section" aria-labelledby="latest-videos-heading">
      <div class="container">
        <div class="section-head">
          <h2 id="latest-videos-heading">Latest videos</h2>
          <a href="/videos" class="link">All videos</a>
        </div>
        <div class="rail" tabindex="0" role="region" aria-label="Latest videos, scroll sideways">
          {latestVideos.map((video) => <VideoCard video={video} headingLevel={3} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="faq-heading">
    <div class="container faq">
      <div>
        <h2 id="faq-heading">Frequently asked</h2>
        <p>
          A handful of questions I get often. If yours isn&rsquo;t here, the <a href="/about" class="link">about page</a> goes into more detail on how the site is built and what to expect.
        </p>
      </div>
      <dl>
        <div>
          <dt>Do I need to watch the video to understand the post?</dt>
          <dd>
            No. Every post is self-contained: diagrams, code samples, references, and the same trade-off discussion. The embedded video is there if you prefer the spoken explanation or want to skip to a chapter, but reading the article alone is enough to follow the argument and ship the change.
          </dd>
        </div>
        <div>
          <dt>Why a blog if you already have a channel?</dt>
          <dd>
            Some things are slow to read on a slide and faster in prose: API signatures, command-line flags, JSON payloads, performance numbers. The blog also makes it possible to deep-link a teammate to a specific section, copy a code snippet without pausing playback, and search the whole catalogue with browser find.
          </dd>
        </div>
        <div>
          <dt>How often is new content published?</dt>
          <dd>
            Videos go up roughly twice a week. The companion post lands on the same day for new releases and is back-filled in batches for the existing catalogue. You can keep an eye on the latest drops via the <a href="/rss.xml" class="link">site feed</a> or the channel itself.
          </dd>
        </div>
        <div>
          <dt>Can I share these posts in talks, classes, or team docs?</dt>
          <dd>
            Yes, please. That&rsquo;s exactly what they&rsquo;re here for. Drop a link to the post in your Slack, study group, or course notes. If you find something wrong or want to suggest a follow-up topic, the channel comments and the contact details on the about page both reach me.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <SubscribeCTA />
</BaseLayout>

<script>
  // Series switcher: arrow keys move between tabs; every panel shows without script.
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)?.classList.toggle('is-active', on);
      }
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (step) { e.preventDefault(); select(tabs[(i + step + tabs.length) % tabs.length], true); }
        if (e.key === 'Home') { e.preventDefault(); select(tabs[0], true); }
        if (e.key === 'End') { e.preventDefault(); select(tabs[tabs.length - 1], true); }
      });
    });
  }
</script>
