---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import {
  getPublishedPosts,
  slugifyTag,
  summarizeTags,
  type Post,
} from '@/lib/posts';
import { breadcrumbJsonLd } from '@/lib/seo';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = summarizeTags(posts);
  return tags.map(({ slug, tag }) => {
    const matched = posts.filter((post) =>
      post.data.tags.some((t) => slugifyTag(t) === slug),
    );
    return {
      params: { tag: slug },
      props: { tag, slug, posts: matched },
    };
  });
}

interface Props {
  tag: string;
  slug: string;
  posts: Post[];
}

const { tag, slug, posts } = Astro.props;
const title = `Posts tagged #${tag}`;
const description = `Every LearnwithManoj engineering post tagged #${tag} — ${posts.length} ${posts.length === 1 ? 'article' : 'articles'}.`;
const path = `/tags/${slug}`;
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: '/' },
    { name: 'Topics', url: '/tags' },
    { name: `#${tag}`, url: path },
  ]),
];
---
<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <header class="mb-8">
    <p class="text-sm text-slate-500 dark:text-slate-400">
      <a href="/tags" class="hover:underline">All topics</a>
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
      <span class="text-slate-500 dark:text-slate-400">#</span>{tag}
    </h1>
    <p class="mt-3 text-slate-600 dark:text-slate-300">
      {posts.length} {posts.length === 1 ? 'post' : 'posts'} on this topic.
    </p>
  </header>

  <div class="grid gap-4 sm:grid-cols-2">
    {posts.map((post) => <PostCard post={post} headingLevel={2} />)}
  </div>
</BaseLayout>
