---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostRow from '@/components/PostRow.astro';
import {
  getPublishedPosts,
  relatedTags,
  slugifyTag,
  summarizeTags,
  tagBody,
  tagMeta,
  type Post,
  type TagSummary,
} from '@/lib/posts';
import { breadcrumbJsonLd } from '@/lib/seo';
import { postUrl } from '@/lib/posts';
import { SERIES, seriesEpisodes } from '@/lib/series';
import { fetchLatestVideos } from '@/lib/youtube';
import { YT_CHANNEL_ID } from '@/consts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = summarizeTags(posts);
  return tags.map(({ slug, tag }) => {
    const matched = posts.filter((post) =>
      post.data.tags.some((t) => slugifyTag(t) === slug),
    );
    const related = relatedTags(slug, posts);
    return {
      params: { tag: slug },
      props: { tag, slug, posts: matched, related },
    };
  });
}

interface Props {
  tag: string;
  slug: string;
  posts: Post[];
  related: TagSummary[];
}

const { tag, slug, posts, related } = Astro.props;

// A series tag lists its posts as the series syllabus, in episode order.
const seriesDef = SERIES.find((s) => s.tags.includes(slug));
const episodes = seriesDef
  ? seriesEpisodes(
      { ...seriesDef, tags: [slug] },
      posts,
      new Map((await fetchLatestVideos(YT_CHANNEL_ID)).map((v) => [v.id, v.title])),
    )
  : [];
const description = tagMeta(slug, tag);
const bodyLede = tagBody(slug, tag);
const bodyParagraphs = bodyLede.split('\n\n');
const title = `#${tag}: posts and videos`;
const path = `/tags/${slug}`;
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: '/' },
    { name: 'Topics', url: '/tags' },
    { name: `#${tag}`, url: path },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `Posts tagged #${tag}`,
    description,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: posts.length,
      itemListElement: posts.map((post, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        url: `${import.meta.env.SITE ?? ''}/blog/${post.id}`,
        name: post.data.title,
      })),
    },
  },
];
---
<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <div class="container">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href="/tags">All topics</a></li>
        <li aria-current="page">#{tag}</li>
      </ol>
    </nav>
    <header class="page-head tag-head">
      <h1>#{tag}</h1>
      <div>
        {bodyParagraphs.map((para) => <p>{para}</p>)}
        <p class="meta">{posts.length} {posts.length === 1 ? 'post' : 'posts'} below, {seriesDef ? 'in episode order' : 'newest first'}.</p>
      </div>
    </header>

    {seriesDef ? (
      <ol class="syllabus syllabus--page">
        {episodes.map((e) => (
          <li class:list={{ 'is-start': e.isStart }}>
            <span class="num">{e.number}</span>
            <a href={postUrl(e.post)}>{e.post.data.title}</a>
            {e.isStart && <span class="start">Start here</span>}
          </li>
        ))}
      </ol>
    ) : (
      <ol class="rows">
        {posts.map((post) => <PostRow post={post} headingLevel={2} />)}
      </ol>
    )}

    {related.length > 0 && (
      <section class="section" aria-labelledby="related-topics-heading">
        <div class="section-head">
          <h2 id="related-topics-heading">Related topics</h2>
          <p>Subjects that frequently appear alongside #{tag}. Click through to see every post on each one.</p>
        </div>
        <ol class="rows">
          {related.map((r) => (
            <li class="row topic-row">
              <span class="count">{r.count} {r.count === 1 ? 'post' : 'posts'}</span>
              <div>
                <h3 class="row-title"><a href={`/tags/${r.slug}`}>#{r.tag}</a></h3>
                <p>{tagMeta(r.slug, r.tag)}</p>
              </div>
              <span></span>
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>
</BaseLayout>
