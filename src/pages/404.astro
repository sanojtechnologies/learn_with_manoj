---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_TITLE } from '@/consts';
---
<BaseLayout
  title="Page not found"
  description={`The page you were looking for doesn't exist on ${SITE_TITLE}.`}
  path="/404"
  noindex
  skipDefaultJsonLd
>
  <section class="mx-auto max-w-xl py-12 text-center">
    <p class="text-sm font-medium uppercase tracking-wide text-brand-600 dark:text-brand-500">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">Page not found</h1>
    <p class="mt-3 text-slate-600 dark:text-slate-300">
      That page moved, was renamed, or never existed. Try the blog or the videos page instead.
    </p>
    <div class="mt-6 flex justify-center gap-3">
      <a href="/" class="inline-flex items-center rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition-colors hover:bg-brand-700">Home</a>
      <a href="/blog" class="inline-flex items-center rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Read the blog</a>
    </div>
  </section>
</BaseLayout>
