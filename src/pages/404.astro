---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_TITLE } from '@/consts';
---
<BaseLayout
  title="Page not found"
  description={`The page you were looking for doesn’t exist on ${SITE_TITLE}.`}
  path="/404"
  noindex
  skipDefaultJsonLd
>
  <section class="container page-head notfound">
    <h1>404: page not found</h1>
    <p class="lead">
      That page moved, was renamed, or never existed.
    </p>
    <div class="hero-actions">
      <a href="/" class="btn">Home</a>
      <a href="/blog" class="btn btn--quiet">Read the blog</a>
    </div>
  </section>
</BaseLayout>
