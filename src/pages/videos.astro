---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VideoCard from '@/components/VideoCard.astro';
import SubscribeCTA from '@/components/SubscribeCTA.astro';
import { SITE_TITLE, YT_CHANNEL_ID, YT_CHANNEL_URL, YT_HANDLE } from '@/consts';
import { fetchLatestVideos } from '@/lib/youtube';
import { breadcrumbJsonLd, videoObjectJsonLd } from '@/lib/seo';

const videos = await fetchLatestVideos(YT_CHANNEL_ID);
const title = `Videos by ${YT_HANDLE}`;
const description = `Every engineering video from the ${SITE_TITLE} YouTube channel, auto-synced from the channel uploads.`;
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: '/' },
    { name: 'Videos', url: '/videos' },
  ]),
  // Every dated upload as a VideoObject, in one @graph so the page carries a
  // single block. Videos link out to YouTube, so this is a plain list, not an
  // ItemList carousel (which needs on-site detail pages).
  {
    '@context': 'https://schema.org',
    '@graph': videos
      .filter((v) => v.publishedAt)
      .map((v) => {
        const { ['@context']: _ctx, ...obj } = videoObjectJsonLd({
          videoId: v.id,
          name: v.title,
          description: v.description || v.title,
          uploadDate: v.publishedAt!.toISOString(),
          thumbnailUrl: v.thumbnail,
        });
        return obj;
      }),
  },
];
---
<BaseLayout title={title} description={description} path="/videos" jsonLd={jsonLd}>
  <div class="container">
    <header class="page-head">
      <h1>Videos</h1>
      <p class="lead">
        All {videos.length} uploads from the
        <a href={YT_CHANNEL_URL} target="_blank" rel="noopener" class="link">{YT_HANDLE}</a>
        channel, newest first.
      </p>
    </header>

    {videos.length === 0 ? (
      <p>
        No videos to show yet. Set <code>YT_CHANNEL_ID</code> in
        <code>src/consts.ts</code> and rebuild to populate this page from the
        channel’s public RSS feed.
      </p>
    ) : (
      <div class="video-grid">
        {videos.map((video, i) => <VideoCard video={video} headingLevel={2} eager={i < 4} />)}
      </div>
    )}
  </div>

  <SubscribeCTA />
</BaseLayout>
